# WorkOps environment template.
# Copy to `.env` (local/bare-metal) and fill in values. Never commit real secrets.
# Full reference: docs/configuration.md

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Local Docker compose example: postgresql://workops:PASSWORD@localhost:5432/workops?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js JWT signing secret. Generate with:  openssl rand -base64 32
AUTH_SECRET="generate-a-strong-random-secret"

# ---------------------------------------------------------------------------
# AUTH / URLS
# ---------------------------------------------------------------------------

# Absolute base URL used for auth callbacks and links.
NEXTAUTH_URL=http://localhost:3000
# Needed when running behind a reverse proxy with a different internal host.
AUTH_TRUST_HOST=true

# Microsoft Entra ID (Azure AD) - optional corporate login.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ---------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS (features degrade gracefully when unset)
# ---------------------------------------------------------------------------

# Transactional email (password reset). Without it, reset emails are not sent.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# Explicitly trusted email domains for manually entered digest recipients.
# Comma-separated; unset means no domain is implicitly trusted.
COMMUNICATION_INTERNAL_DOMAINS=

# AI report generation.
GLM_API_KEY=

# Bearer token required by /api/cron/* endpoints.
CRON_SECRET=

# Base64 32-byte encryption key for admin-managed provider credentials.
# Generate with:  openssl rand -base64 32
SABAH_CREDENTIAL_KEY=

# Web push notifications (VAPID keys).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:you@example.com

# Svix/Resend webhook signing secret.
# WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# INSTALL / BUILD HELPERS (all default OFF - see docs/deployment/vercel.md)
# ---------------------------------------------------------------------------

# Set to 1 to let a build (Vercel/CI) initialize an EMPTY database explicitly.
# Refuses any database that already contains tables. Never enables itself.
# WORKOPS_DB_INIT_ON_BUILD=

# Set to 1 to let a build apply pending migrations (safe, pending-only).
# Only enable for environments that own their database.
# WORKOPS_DB_MIGRATE_ON_BUILD=

# First production deployment only: create the first admin AND its workspace.
# Requires ADMIN_EMAIL/ADMIN_PASSWORD. Existing users are never overwritten.
# Disable after bootstrap and remove ADMIN_PASSWORD from the platform settings.
# WORKOPS_BOOTSTRAP_ADMIN_ON_BUILD=

# ---------------------------------------------------------------------------
# ADMIN BOOTSTRAP (npm run setup:admin; env alternative to the hidden prompt)
# ---------------------------------------------------------------------------

# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# DOCKER COMPOSE (used by compose.yaml; keep .env out of git)
# ---------------------------------------------------------------------------

# POSTGRES_USER=workops
# POSTGRES_PASSWORD=          # REQUIRED for compose; no default on purpose
# POSTGRES_DB=workops
# APP_PORT=3000
